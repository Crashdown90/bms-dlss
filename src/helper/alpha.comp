// bms-dlss: po DLSS vrati do vystupu alfu ze vstupu sceny.
//
// DLSS bez AlphaUpscaling (Programming Guide 3.16) alfu nezpracovava, ve vystupu je nesmysl.
// Alfa sceny ale jde dal (COLOR_OUT -> barva sceny -> _rt_FullFrameFB) a post-process ji muze cist.
// DLAA: vstup ma stejne rozliseni jako vystup, alfa je ze stejneho pixelu (alphaScale = 1, presne).
// Cast B (od verze 10, mat_viewportscale): vstup je sub-rect COLOR_IN od (0, 0), vystup cely obraz. Alfa se cte
// z texelu vstupu pod stredem vystupniho pixelu: ivec2((p + 0.5) * alphaScale), alphaScale = render / vystup
// (odpovida roztazeni, ktere by udelal engine; nikdy nesaha mimo sub-rect).
//
// Varianta HDR_IN (build.ps1 -> alpha_hdr_comp.h, [dlaa] InputMode 1, 2 a 3): vystup DLSS je linearni
// RGBA16F, tento pruchod ho prevede presnou inverzi EOTF sRGB zpet do sRGB RGBA8 (vstup RCAS i blitu).
// InputMode 3: predtem inverze rozsireni z linearize.comp, rgb = h / (1 + k * lum(h)) (k = 0 -> identita).
#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 1) uniform sampler2D uColor;        // COLOR_IN

// Stejny blok pro obe varianty (helper.cpp, AlphaPush): k na offsetu 0, alphaScale na offsetu 8
layout(push_constant) uniform Push {
    float k;          // HDR_IN: sila inverzniho tone mappingu (stejna jako v linearize.comp), 0 = vypnuto
    vec2 alphaScale;  // velikost vstupu / velikost vystupu po osach (1 = stejna mrizka)
} pc;

#ifdef HDR_IN
layout(binding = 6, rgba16f) uniform readonly image2D uHdr;  // vystup DLSS (linearni HDR)
layout(binding = 3, rgba8) uniform writeonly image2D uOut;   // vystup v sRGB (RGBA8)

const vec3 kLumW = vec3(0.2126, 0.7152, 0.0722);  // Rec. 709

vec3 InverseItm(vec3 h) {
    // zaporne a NaN -> 0, +inf -> max. RGBA16F (jinak by inf / inf dalo NaN)
    h = mix(vec3(0.0), min(h, vec3(65504.0)), greaterThan(h, vec3(0.0)));
    return h / (1.0 + dot(h, kLumW) * pc.k);
}

vec3 LinearToSrgb(vec3 l) {
    // zaporne a NaN -> 0, nad 1 -> 1 (vysledek jde do LDR obrazu sceny)
    l = mix(vec3(0.0), min(l, vec3(1.0)), greaterThan(l, vec3(0.0)));
    return mix(l * 12.92, 1.055 * pow(l, vec3(1.0 / 2.4)) - 0.055, greaterThan(l, vec3(0.0031308)));
}
#else
layout(binding = 3, rgba8) uniform image2D uOut;     // vystup DLSS (RGBA8, cteni i zapis)
#endif

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(uOut);
    if (p.x >= size.x || p.y >= size.y) return;
#ifdef HDR_IN
    vec4 c = vec4(LinearToSrgb(InverseItm(imageLoad(uHdr, p).rgb)), 0.0);
#else
    vec4 c = imageLoad(uOut, p);
#endif
    c.a = texelFetch(uColor, ivec2((vec2(p) + 0.5) * pc.alphaScale), 0).a;
    imageStore(uOut, p, c);
}
