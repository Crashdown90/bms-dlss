#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D uIn;                   // kopie generovaneho snimku
layout(binding = 1, rgba8) uniform writeonly image2D uSharp; // doostreny snimek

layout(push_constant) uniform Push {
    float con;  // exp2(-stops): 1 = nejostrejsi, 0.25 = slabe (FSR 2 mapuje sharpness s na stops = 2 - 2s)
} pc;

// Maximalni zaporny lalok filtru (FSR_RCAS_LIMIT)
const float kLimit = 0.25 - 1.0 / 16.0;

vec3 Load(ivec2 p, ivec2 size) { return texelFetch(uIn, clamp(p, ivec2(0), size - 1), 0).rgb; }

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = textureSize(uIn, 0);
    if (p.x >= size.x || p.y >= size.y) return;

    //    b
    //  d e f
    //    h
    vec3 b = Load(p + ivec2(0, -1), size);
    vec3 d = Load(p + ivec2(-1, 0), size);
    vec3 e = Load(p, size);
    vec3 f = Load(p + ivec2(1, 0), size);
    vec3 h = Load(p + ivec2(0, 1), size);

    // Potlaceni sumu: jas x2, odchylka stredu od okoli vztazena k rozsahu jasu.
    float bL = b.b * 0.5 + (b.r * 0.5 + b.g);
    float dL = d.b * 0.5 + (d.r * 0.5 + d.g);
    float eL = e.b * 0.5 + (e.r * 0.5 + e.g);
    float fL = f.b * 0.5 + (f.r * 0.5 + f.g);
    float hL = h.b * 0.5 + (h.r * 0.5 + h.g);
    float nz = 0.25 * (bL + dL + fL + hL) - eL;
    float range = max(max(max(bL, dL), max(eL, fL)), hL) - min(min(min(bL, dL), min(eL, fL)), hL);
    nz = range > 0.0 ? clamp(abs(nz) / range, 0.0, 1.0) : 0.0;
    nz = -0.5 * nz + 1.0;

    // Min a max kruhu kolem stredu, z nich nejvetsi lalok, ktery jeste neprestreli rozsah 0..1.
    vec3 mn4 = min(min(b, d), min(f, h));
    vec3 mx4 = max(max(b, d), max(f, h));
    // Kanal, ktery je v celem kruhu 0 (resp. 1), nemuze podstrelit (prestrelit) - v AMD vyjde 0*inf = NaN a max()
    // ho zahodi, tedy kanal lalok neomezuje. Totez explicitne (GLSL max s NaN je nedefinovany); stary clamp na
    // 1e-5 tu daval 0 a vypinal doostreni pixelu se saturovanym kanalem.
    vec3 hitMin = mix(vec3(1e30), min(mn4, e) / max(4.0 * mx4, vec3(1e-30)), greaterThan(mx4, vec3(0.0)));
    vec3 hitMax = mix(vec3(-1e30), (1.0 - max(mx4, e)) / min(4.0 * mn4 - 4.0, vec3(-1e-30)), lessThan(mn4, vec3(1.0)));
    vec3 lobeRGB = max(-hitMin, hitMax);
    float lobe = max(-kLimit, min(max(lobeRGB.r, max(lobeRGB.g, lobeRGB.b)), 0.0)) * pc.con;
    lobe *= nz;

    // Vysledek: vazeny prumer stredu a kruhu (zaporne vahy = doostreni)
    vec3 c = (lobe * (b + d + f + h) + e) / (4.0 * lobe + 1.0);
    imageStore(uSharp, p, vec4(clamp(c, 0.0, 1.0), texelFetch(uIn, p, 0).a));
}
