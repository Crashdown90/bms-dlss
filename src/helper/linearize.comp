// bms-dlss: vstup DLSS v linearnim HDR ([dlaa] InputMode 1, 2 a 3, Alt+Insert).
//
// Barva sceny (COLOR_IN, BGRA8 UNORM) je po tonemapovani v sRGB. Pro DLSS s IsHDR = 1 ji tento
// pruchod prevede presnou EOTF sRGB (IEC 61966-2-1) do linearniho RGBA16F (Programming Guide 3.1.2:
// linearni barvy jen v rezimu HDR). Rozsah zustava 0..1, expozice pro DLSS je 1.0 (Guide 3.9).
// Zpet do sRGB to prevadi alpha.comp (varianta HDR_IN), jeste pred doostrenim RCAS.
//
// InputMode 3 (k > 0, [dlaa] ITMStrength): inverzni tone mapping - po linearizaci rozsireni jasovym
// Reinhardem h = rgb / (1 - k * lum(rgb)), rozsah 0..1 -> 0..1/(1-k) (k = 0.95 -> 20). Plati
// lum(h) = lum / (1 - k * lum), proto alpha.comp HDR_IN vraci presne rgb = h / (1 + k * lum(h)) se stejnym k.
// Pro modu 1 a 2 je k = 0 (identita).
#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 1) uniform sampler2D uColor;                 // COLOR_IN (hodnoty v sRGB)
layout(binding = 5, rgba16f) uniform writeonly image2D uLin;  // vstup DLSS (linearni)

layout(push_constant) uniform Push {
    float k;  // sila inverzniho tone mappingu 0..0.99, 0 = vypnuto
} pc;

const vec3 kLumW = vec3(0.2126, 0.7152, 0.0722);  // Rec. 709

vec3 SrgbToLinear(vec3 c) {
    return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), greaterThan(c, vec3(0.04045)));
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(uLin);
    if (p.x >= size.x || p.y >= size.y) return;
    vec4 c = texelFetch(uColor, p, 0);
    vec3 l = SrgbToLinear(c.rgb);
    l *= 1.0 / max(1.0 - dot(l, kLumW) * pc.k, 1e-3);  // k <= 0.99 a lum <= 1 -> jmenovatel >= 0.01
    imageStore(uLin, p, vec4(l, c.a));
}
